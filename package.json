{
  "name": "jass-layoutlab-studio",
  "version": "0.3.4",
  "private": true,
  "description": "Visual React layout workbench with compatible React 17, React Grid Layout and Muuri React adapters.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-grid-layout": "^2.2.4",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3",
    "muuri-react": "^3.1.7"
  },
  "devDependencies": {}
}
